{
  "id": "twisted_rope",
  "name": "Twisted Rope",
  "icon": "🪢",
  "order": 320,
  "description": "A thick twisted rope with diagonal-looking strands that slowly turn.",
  "params": [
    {
      "key": "color",
      "label": "Fiber",
      "type": "color",
      "default": "#d9b878"
    },
    {
      "key": "color2",
      "label": "Shadow",
      "type": "color",
      "default": "#5a3d1c"
    },
    {
      "key": "width",
      "label": "Thickness",
      "type": "range",
      "min": 3,
      "max": 12,
      "step": 0.5,
      "default": 6.5
    },
    {
      "key": "twist",
      "label": "Twist length",
      "type": "range",
      "min": 3,
      "max": 20,
      "step": 0.5,
      "default": 7
    },
    {
      "key": "speed",
      "label": "Twist speed",
      "type": "range",
      "min": -60,
      "max": 60,
      "step": 1,
      "default": 14
    }
  ],
  "layers": [
    {
      "type": "stroke",
      "color": "#000000",
      "alpha": 0.35,
      "width": "=$width+3",
      "blur": 3
    },
    {
      "type": "stroke",
      "color": "$color2",
      "width": "$width"
    },
    {
      "type": "stroke",
      "color": "$color",
      "width": "=$width*0.86",
      "dash": [
        "=$twist*0.55",
        "=$twist*0.45"
      ],
      "dashSpeed": "$speed",
      "cap": "butt"
    },
    {
      "type": "stroke",
      "color": "#ffffff",
      "alpha": 0.22,
      "width": "=$width*0.22",
      "offset": "=-$width*0.25"
    }
  ],
  "skin": [
    {
      "type": "disc",
      "color": "$color2",
      "radius": 1
    },
    {
      "type": "ring",
      "color": "$color",
      "radius": 0.82,
      "width": 0.3,
      "dash": [
        0.28,
        0.18
      ],
      "speed": 0.15
    },
    {
      "type": "ring",
      "color": "#2b1a0b",
      "radius": 1,
      "width": 0.12
    },
    {
      "type": "disc",
      "color": "$color",
      "radius": 0.22
    }
  ],
  "animated": true
}