{
  "id": "arrows",
  "name": "Flow Arrows",
  "icon": "»",
  "order": 100,
  "description": "Chevrons showing the direction of the data flow.",
  "params": [
    { "key": "color", "label": "Color", "type": "color", "default": "auto" },
    { "key": "size", "label": "Size", "type": "range", "min": 2, "max": 10, "step": 0.5, "default": 4.5 },
    { "key": "spacing", "label": "Spacing", "type": "range", "min": 14, "max": 100, "step": 2, "default": 34 },
    { "key": "speed", "label": "Speed (px/s)", "type": "range", "min": -300, "max": 300, "step": 5, "default": 70 },
    { "key": "line", "label": "Wire opacity", "type": "range", "min": 0, "max": 1, "step": 0.05, "default": 0.35 }
  ],
  "layers": [
    { "type": "stroke", "color": "$color", "alpha": "$line", "width": 2 },
    { "type": "dots", "shape": "chevron", "color": "$color", "size": "$size", "spacing": "$spacing", "speed": "$speed" }
  ],
  "skin": [
    { "type": "disc", "color": "#15171a", "radius": 1 },
    { "type": "ring", "color": "$color", "radius": 1, "width": 0.16, "dash": [0.5, 0.35], "speed": 0.5 },
    { "type": "disc", "color": "$color", "radius": 0.3 }
  ]
}
