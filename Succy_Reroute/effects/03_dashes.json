{
  "id": "dashes",
  "name": "Marching Dashes",
  "icon": "┅",
  "order": 30,
  "description": "Animated dashes marching along the wire.",
  "params": [
    { "key": "color", "label": "Color", "type": "color", "default": "auto" },
    { "key": "width", "label": "Width", "type": "range", "min": 1, "max": 8, "step": 0.5, "default": 3 },
    { "key": "dash", "label": "Dash length", "type": "range", "min": 3, "max": 40, "step": 1, "default": 14 },
    { "key": "gap", "label": "Gap length", "type": "range", "min": 2, "max": 40, "step": 1, "default": 9 },
    { "key": "speed", "label": "Speed (px/s)", "type": "range", "min": -200, "max": 200, "step": 5, "default": 60 }
  ],
  "layers": [
    { "type": "stroke", "color": "$color", "alpha": 0.16, "width": "$width" },
    { "type": "stroke", "color": "$color", "width": "$width", "cap": "butt", "dash": ["$dash", "$gap"], "dashSpeed": "$speed" }
  ],
  "skin": [
    { "type": "disc", "color": "#181a1b", "radius": 1 },
    { "type": "spin", "color": "$color", "radius": 1, "width": 0.2, "count": 3, "span": 0.55, "speed": "=$speed/160" },
    { "type": "disc", "color": "$color", "radius": 0.3, "alpha": 0.8 }
  ]
}
