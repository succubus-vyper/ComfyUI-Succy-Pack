{
  "id": "wave",
  "name": "Wave",
  "icon": "〰",
  "order": 70,
  "description": "Sine wave rippling along the wire.",
  "params": [
    { "key": "color", "label": "Color", "type": "color", "default": "auto" },
    { "key": "width", "label": "Width", "type": "range", "min": 1, "max": 8, "step": 0.5, "default": 2.5 },
    { "key": "amp", "label": "Amplitude", "type": "range", "min": 0, "max": 30, "step": 1, "default": 6 },
    { "key": "wavelength", "label": "Wavelength", "type": "range", "min": 20, "max": 200, "step": 5, "default": 70 },
    { "key": "speed", "label": "Speed", "type": "range", "min": -10, "max": 10, "step": 0.5, "default": 3 }
  ],
  "layers": [
    { "type": "stroke", "color": "$color", "alpha": 0.18, "width": 1.5 },
    { "type": "stroke", "color": "$color", "width": "$width", "step": 4, "blur": 4,
      "displace": "=$amp*sin(s/$wavelength*6.2832 - t*$speed)*sin(v*3.14159)" }
  ],
  "skin": [
    { "type": "disc", "color": "#14171a", "radius": 1 },
    { "type": "pulse", "color": "$color", "from": 0.5, "to": 1.9, "period": 1.8, "width": 0.12 },
    { "type": "ring", "color": "$color", "radius": 1, "width": 0.14 },
    { "type": "disc", "color": "$color", "radius": 0.34 }
  ]
}
