{
  "id": "gem_necklace",
  "name": "Gem Necklace",
  "icon": "💎",
  "order": 400,
  "description": "A fine golden chain set with shimmering multicolored gems that sparkle in turn.",
  "params": [
    {
      "key": "color",
      "label": "Chain",
      "type": "color",
      "default": "#e2c36a"
    },
    {
      "key": "spacing",
      "label": "Gem spacing",
      "type": "range",
      "min": 14,
      "max": 60,
      "step": 1,
      "default": 27
    },
    {
      "key": "size",
      "label": "Gem size",
      "type": "range",
      "min": 2,
      "max": 7,
      "step": 0.1,
      "default": 3.4
    },
    {
      "key": "hue",
      "label": "Hue start",
      "type": "range",
      "min": 0,
      "max": 360,
      "step": 5,
      "default": 200
    },
    {
      "key": "speed",
      "label": "Drift (px/s)",
      "type": "range",
      "min": -60,
      "max": 60,
      "step": 1,
      "default": 14
    }
  ],
  "layers": [
    {
      "type": "stroke",
      "color": "$color",
      "alpha": 0.85,
      "width": 1.3
    },
    {
      "type": "stroke",
      "color": "#ffffff",
      "alpha": 0.25,
      "width": 0.5,
      "offset": -0.5
    },
    {
      "type": "dots",
      "shape": "diamond",
      "color": "=hsl($hue+rnd(i*4.1)*220,85,62)",
      "size": "=$size*(0.85+0.3*sin(t*2.4+i*1.3))",
      "spacing": "$spacing",
      "speed": "$speed",
      "blur": 6
    },
    {
      "type": "dots",
      "shape": "star",
      "color": "#ffffff",
      "size": "=$size*0.7",
      "spacing": "$spacing",
      "speed": "$speed",
      "alpha": "=pow(max(0,sin(t*2.6+i*2.1)),6)",
      "composite": "lighter"
    }
  ],
  "skin": [
    {
      "type": "disc",
      "color": "#1a1608",
      "radius": 1
    },
    {
      "type": "ring",
      "color": "$color",
      "radius": 1,
      "width": 0.18
    },
    {
      "type": "orbit",
      "color": "=hsl(t*40,85,65)",
      "radius": 0.62,
      "size": 0.2,
      "count": 5,
      "speed": 0.18,
      "blur": 4
    },
    {
      "type": "disc",
      "color": "=hsl($hue+t*30,85,65)",
      "radius": 0.26,
      "blur": 6
    }
  ],
  "animated": true
}