{
  "id": "aurora",
  "name": "Aurora",
  "icon": "🌌",
  "order": 210,
  "description": "Northern-lights ribbons with a hue gradient that flows across the whole route.",
  "params": [
    {
      "key": "hue",
      "label": "Start hue",
      "type": "range",
      "min": 0,
      "max": 360,
      "step": 1,
      "default": 140
    },
    {
      "key": "spread",
      "label": "Hue range",
      "type": "range",
      "min": 0,
      "max": 240,
      "step": 5,
      "default": 110
    },
    {
      "key": "width",
      "label": "Ribbon width",
      "type": "range",
      "min": 1,
      "max": 8,
      "step": 0.5,
      "default": 3
    },
    {
      "key": "amp",
      "label": "Amplitude",
      "type": "range",
      "min": 0,
      "max": 24,
      "step": 0.5,
      "default": 10
    },
    {
      "key": "wavelength",
      "label": "Wavelength",
      "type": "range",
      "min": 40,
      "max": 260,
      "step": 5,
      "default": 120
    },
    {
      "key": "speed",
      "label": "Speed",
      "type": "range",
      "min": -3,
      "max": 3,
      "step": 0.1,
      "default": 0.7
    },
    {
      "key": "glow",
      "label": "Glow",
      "type": "range",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 14
    }
  ],
  "layers": [
    {
      "type": "stroke",
      "perSegment": true,
      "step": 6,
      "composite": "lighter",
      "blur": "$glow",
      "alpha": 0.5,
      "width": "=$width*1.35",
      "color": "=hsl($hue+$spread*u+30*sin(t*0.5+0),85,58)",
      "displace": "=$amp*sin(s/$wavelength*6.2832 - t*$speed + 0.0)*sin(v*3.14159)"
    },
    {
      "type": "stroke",
      "perSegment": true,
      "step": 6,
      "composite": "lighter",
      "blur": "$glow",
      "alpha": 0.5,
      "width": "=$width*1.05",
      "color": "=hsl($hue+$spread*u+30*sin(t*0.5+1),85,62)",
      "displace": "=$amp*sin(s/$wavelength*6.2832 - t*$speed + 2.1)*sin(v*3.14159)"
    },
    {
      "type": "stroke",
      "perSegment": true,
      "step": 6,
      "composite": "lighter",
      "blur": "$glow",
      "alpha": 0.5,
      "width": "=$width*0.75",
      "color": "=hsl($hue+$spread*u+30*sin(t*0.5+2),85,66)",
      "displace": "=$amp*sin(s/$wavelength*6.2832 - t*$speed + 4.2)*sin(v*3.14159)"
    }
  ],
  "skin": [
    {
      "type": "disc",
      "color": "#08121a",
      "radius": 1
    },
    {
      "type": "glow",
      "color": "=hsl($hue+$spread*0.5,85,60)",
      "radius": 2.2,
      "alpha": 0.3
    },
    {
      "type": "spin",
      "color": "=hsl($hue,85,62)",
      "radius": 1,
      "width": 0.18,
      "count": 3,
      "span": 0.55,
      "speed": 0.25
    },
    {
      "type": "spin",
      "color": "=hsl($hue+$spread,85,62)",
      "radius": 0.66,
      "width": 0.14,
      "count": 2,
      "span": 0.5,
      "speed": -0.35
    }
  ]
}
