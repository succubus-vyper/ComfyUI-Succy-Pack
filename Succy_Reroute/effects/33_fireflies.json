{
  "id": "fireflies",
  "name": "Fireflies",
  "icon": "✨",
  "order": 330,
  "description": "Soft lights that drift lazily around the wire and twinkle like fireflies at dusk.",
  "params": [
    {
      "key": "color",
      "label": "Light",
      "type": "color",
      "default": "#d6ff5c"
    },
    {
      "key": "count",
      "label": "Amount",
      "type": "range",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 12
    },
    {
      "key": "size",
      "label": "Size",
      "type": "range",
      "min": 1,
      "max": 5,
      "step": 0.1,
      "default": 2.2
    },
    {
      "key": "drift",
      "label": "Wander",
      "type": "range",
      "min": 2,
      "max": 30,
      "step": 1,
      "default": 15
    },
    {
      "key": "speed",
      "label": "Drift (px/s)",
      "type": "range",
      "min": -80,
      "max": 80,
      "step": 1,
      "default": 14
    }
  ],
  "layers": [
    {
      "type": "stroke",
      "color": "$color",
      "alpha": 0.06,
      "width": 1.5
    },
    {
      "type": "dots",
      "color": "$color",
      "count": "$count",
      "size": "$size",
      "speed": "$speed",
      "alpha": "=0.08+0.92*pow(0.5+0.5*sin(t*(0.9+1.6*rnd(i))*2.4+i*5.3),3)",
      "blur": 6,
      "composite": "lighter",
      "displace": "=$drift*(0.65*sin(t*0.7+i*2.3)+0.35*sin(t*1.7+i*5.1))*sin(v*3.14159)"
    },
    {
      "type": "dots",
      "color": "#ffffff",
      "count": "$count",
      "size": "=$size*0.38",
      "speed": "$speed",
      "alpha": "=0.9*pow(0.5+0.5*sin(t*(0.9+1.6*rnd(i))*2.4+i*5.3),3)",
      "displace": "=$drift*(0.65*sin(t*0.7+i*2.3)+0.35*sin(t*1.7+i*5.1))*sin(v*3.14159)"
    }
  ],
  "skin": [
    {
      "type": "disc",
      "color": "#0b1204",
      "radius": 1
    },
    {
      "type": "ring",
      "color": "$color",
      "radius": 1,
      "width": 0.1,
      "alpha": 0.5
    },
    {
      "type": "orbit",
      "color": "$color",
      "radius": 0.55,
      "size": 0.14,
      "count": 4,
      "speed": 0.12,
      "blur": 6
    },
    {
      "type": "disc",
      "color": "$color",
      "radius": "=0.12+0.1*sin(t*2.2)",
      "blur": 8
    }
  ],
  "animated": true
}