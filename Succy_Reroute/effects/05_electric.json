{
  "id": "electric",
  "name": "Electric",
  "icon": "⚡",
  "order": 50,
  "description": "Crackling lightning that jitters along the wire.",
  "params": [
    { "key": "color", "label": "Color", "type": "color", "default": "auto" },
    { "key": "width", "label": "Width", "type": "range", "min": 1, "max": 6, "step": 0.5, "default": 2 },
    { "key": "amp", "label": "Amplitude", "type": "range", "min": 1, "max": 30, "step": 1, "default": 9 },
    { "key": "fps", "label": "Crackle rate", "type": "range", "min": 2, "max": 30, "step": 1, "default": 14 },
    { "key": "glow", "label": "Glow", "type": "range", "min": 0, "max": 30, "step": 1, "default": 14 }
  ],
  "layers": [
    { "type": "stroke", "color": "$color", "alpha": 0.15, "width": 1.5 },
    { "type": "stroke", "color": "$color", "width": "$width", "step": 7, "blur": "$glow",
      "displace": "=$amp*(rnd(i*7.13+floor(t*$fps)*91.7)*2-1)*sin(v*3.14159)" },
    { "type": "stroke", "color": "#ffffff", "width": "=$width*0.5", "alpha": 0.75, "step": 7,
      "displace": "=$amp*(rnd(i*3.71+floor(t*$fps)*53.1+9)*2-1)*sin(v*3.14159)" }
  ],
  "skin": [
    { "type": "glow", "color": "$color", "radius": 2, "alpha": "=0.2+0.25*rnd(floor(t*$fps))" },
    { "type": "disc", "color": "#121316", "radius": 1 },
    { "type": "spin", "color": "$color", "radius": 1, "width": 0.16, "count": 4, "span": 0.35, "speed": 1.4, "blur": 5 },
    { "type": "disc", "color": "#ffffff", "radius": 0.28, "alpha": "=0.6+0.4*rnd(floor(t*$fps)+3)" }
  ]
}
