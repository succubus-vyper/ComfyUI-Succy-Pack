{
  "id": "heartbeat",
  "name": "Heartbeat",
  "icon": "💓",
  "order": 310,
  "description": "A monitor-style ECG: heartbeat spikes run along the wire and fade behind.",
  "params": [
    {
      "key": "color",
      "label": "Color",
      "type": "color",
      "default": "#37ff8b"
    },
    {
      "key": "width",
      "label": "Width",
      "type": "range",
      "min": 1,
      "max": 6,
      "step": 0.5,
      "default": 2.2
    },
    {
      "key": "amp",
      "label": "Beat height",
      "type": "range",
      "min": 4,
      "max": 40,
      "step": 1,
      "default": 18
    },
    {
      "key": "period",
      "label": "Beat distance",
      "type": "range",
      "min": 60,
      "max": 400,
      "step": 5,
      "default": 170
    },
    {
      "key": "speed",
      "label": "Speed (px/s)",
      "type": "range",
      "min": -300,
      "max": 300,
      "step": 5,
      "default": 95
    },
    {
      "key": "glow",
      "label": "Glow",
      "type": "range",
      "min": 0,
      "max": 16,
      "step": 1,
      "default": 6
    }
  ],
  "layers": [
    {
      "type": "stroke",
      "color": "$color",
      "alpha": 0.1,
      "width": 1
    },
    {
      "type": "stroke",
      "perSegment": true,
      "step": 3,
      "color": "$color",
      "width": "$width",
      "blur": "$glow",
      "alpha": "=((x)=>0.22+0.78*exp(-pow((x-0.55)*2.6,2)))(fract((s-t*$speed)/$period))",
      "displace": "=-$amp*((x)=>(exp(-pow((x-0.5)*34,2))-0.32*exp(-pow((x-0.455)*55,2))-0.28*exp(-pow((x-0.55)*55,2))+0.22*exp(-pow((x-0.75)*12,2))))(fract((s-t*$speed)/$period))*sin(v*3.14159)"
    }
  ],
  "skin": [
    {
      "type": "disc",
      "color": "#04140c",
      "radius": 1
    },
    {
      "type": "ring",
      "color": "$color",
      "radius": 1,
      "width": 0.12,
      "alpha": 0.7
    },
    {
      "type": "pulse",
      "color": "$color",
      "from": 0.35,
      "to": 1.5,
      "period": 0.9,
      "width": 0.12
    },
    {
      "type": "disc",
      "color": "$color",
      "radius": "=0.24+0.1*sin(t*7)",
      "blur": 6
    }
  ],
  "animated": true
}