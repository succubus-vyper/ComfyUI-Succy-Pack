{
  "id": "particles",
  "name": "Particles",
  "icon": "✦",
  "order": 40,
  "description": "Glowing particles flowing through the wire.",
  "params": [
    { "key": "color", "label": "Color", "type": "color", "default": "auto" },
    { "key": "size", "label": "Size", "type": "range", "min": 1, "max": 8, "step": 0.2, "default": 2.6 },
    { "key": "spacing", "label": "Spacing", "type": "range", "min": 10, "max": 120, "step": 2, "default": 34 },
    { "key": "speed", "label": "Speed (px/s)", "type": "range", "min": -300, "max": 300, "step": 5, "default": 90 },
    { "key": "glow", "label": "Glow", "type": "range", "min": 0, "max": 24, "step": 1, "default": 10 },
    { "key": "line", "label": "Wire opacity", "type": "range", "min": 0, "max": 1, "step": 0.05, "default": 0.25 },
    { "key": "shape", "label": "Shape", "type": "select", "default": "circle", "options": ["circle", "square", "diamond", "star"] }
  ],
  "layers": [
    { "type": "stroke", "color": "$color", "alpha": "$line", "width": 1.6 },
    { "type": "dots", "color": "$color", "shape": "$shape", "size": "$size", "spacing": "$spacing", "speed": "$speed", "blur": "$glow" }
  ],
  "skin": [
    { "type": "disc", "color": "#15171a", "radius": 1 },
    { "type": "ring", "color": "$color", "radius": 1, "width": 0.1, "alpha": 0.55 },
    { "type": "orbit", "color": "$color", "radius": 0.62, "size": 0.2, "count": 3, "speed": 0.45, "blur": 5 }
  ]
}
