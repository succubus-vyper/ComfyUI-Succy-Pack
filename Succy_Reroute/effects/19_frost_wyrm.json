{
  "id": "frost_wyrm",
  "name": "Frost Wyrm",
  "icon": "❄",
  "order": 190,
  "description": "An icy wyrm trailing glittering crystal flakes.",
  "params": [
    {
      "key": "color",
      "label": "Ice",
      "type": "color",
      "default": "#9fe8ff"
    },
    {
      "key": "color2",
      "label": "Frost",
      "type": "color",
      "default": "#ffffff"
    },
    {
      "key": "size",
      "label": "Thickness",
      "type": "range",
      "min": 1.5,
      "max": 7,
      "step": 0.1,
      "default": 3.2
    },
    {
      "key": "length",
      "label": "Length",
      "type": "range",
      "min": 40,
      "max": 300,
      "step": 5,
      "default": 130
    },
    {
      "key": "speed",
      "label": "Speed (px/s)",
      "type": "range",
      "min": -300,
      "max": 300,
      "step": 5,
      "default": 100
    },
    {
      "key": "amp",
      "label": "Amplitude",
      "type": "range",
      "min": 0,
      "max": 16,
      "step": 0.5,
      "default": 6
    },
    {
      "key": "wavelength",
      "label": "Wavelength",
      "type": "range",
      "min": 20,
      "max": 140,
      "step": 2,
      "default": 60
    },
    {
      "key": "flakes",
      "label": "Flake spacing",
      "type": "range",
      "min": 10,
      "max": 70,
      "step": 2,
      "default": 22
    }
  ],
  "layers": [
    {
      "type": "stroke",
      "color": "$color",
      "alpha": 0.15,
      "width": 2,
      "blur": 6
    },
    {
      "type": "dots",
      "color": "$color",
      "size": "$size",
      "spacing": "=L+$length+30",
      "speed": "$speed",
      "trail": "$length",
      "trailSteps": 56,
      "trailTaper": 0.8,
      "trailFade": 0.2,
      "blur": 10,
      "displace": "=$amp*sin(s/$wavelength*6.2832 - t*2.5)*sin(v*3.14159)"
    },
    {
      "type": "dots",
      "color": "$color2",
      "size": "=$size*0.45",
      "spacing": "=L+$length+30",
      "speed": "$speed",
      "displace": "=$amp*sin(s/$wavelength*6.2832 - t*2.5)*sin(v*3.14159)"
    },
    {
      "type": "dots",
      "shape": "diamond",
      "color": "$color2",
      "alpha": 0.8,
      "size": 1.3,
      "spacing": "$flakes",
      "speed": "=-$speed*0.3",
      "blur": 6,
      "displace": "=8*sin(i*2.9+t*1.3)"
    }
  ],
  "skin": [
    {
      "type": "disc",
      "color": "#0a1620",
      "radius": 1
    },
    {
      "type": "spin",
      "color": "$color",
      "radius": 1,
      "width": 0.16,
      "count": 6,
      "span": 0.3,
      "speed": 0.15
    },
    {
      "type": "ring",
      "color": "$color2",
      "radius": 0.7,
      "width": 0.06
    },
    {
      "type": "disc",
      "color": "$color2",
      "radius": 0.22,
      "blur": 6
    }
  ]
}
