{
  "id": "helix",
  "name": "Double Helix",
  "icon": "🧬",
  "order": 90,
  "description": "Two intertwined strands, DNA style.",
  "params": [
    { "key": "color", "label": "Strand A", "type": "color", "default": "auto" },
    { "key": "color2", "label": "Strand B", "type": "color", "default": "#ff5ca8" },
    { "key": "width", "label": "Width", "type": "range", "min": 1, "max": 6, "step": 0.5, "default": 2 },
    { "key": "amp", "label": "Amplitude", "type": "range", "min": 2, "max": 24, "step": 1, "default": 8 },
    { "key": "wavelength", "label": "Wavelength", "type": "range", "min": 30, "max": 200, "step": 5, "default": 80 },
    { "key": "speed", "label": "Speed", "type": "range", "min": -10, "max": 10, "step": 0.5, "default": 3 }
  ],
  "layers": [
    { "type": "stroke", "color": "$color2", "width": "$width", "step": 4, "blur": 4,
      "displace": "=-$amp*sin(s/$wavelength*6.2832 - t*$speed)*sin(v*3.14159)" },
    { "type": "stroke", "color": "$color", "width": "$width", "step": 4, "blur": 4,
      "displace": "=$amp*sin(s/$wavelength*6.2832 - t*$speed)*sin(v*3.14159)" }
  ],
  "skin": [
    { "type": "disc", "color": "#13151a", "radius": 1 },
    { "type": "orbit", "color": "$color", "radius": 0.62, "size": 0.24, "count": 1, "speed": 0.6, "phase": 0, "blur": 5 },
    { "type": "orbit", "color": "$color2", "radius": 0.62, "size": 0.24, "count": 1, "speed": 0.6, "phase": 3.14159, "blur": 5 },
    { "type": "ring", "color": "$color", "radius": 1, "width": 0.08, "alpha": 0.6 }
  ]
}
