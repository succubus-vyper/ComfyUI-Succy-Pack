{
  "id": "hazard_tape",
  "name": "Hazard Tape",
  "icon": "🚧",
  "order": 470,
  "description": "Black-and-yellow security tape crawling along the wire, with blinking red/blue alarm lamps.",
  "params": [
    {
      "key": "color",
      "label": "Tape",
      "type": "color",
      "default": "#fcee0a"
    },
    {
      "key": "width",
      "label": "Width",
      "type": "range",
      "min": 4,
      "max": 12,
      "step": 0.5,
      "default": 8
    },
    {
      "key": "stripe",
      "label": "Stripe",
      "type": "range",
      "min": 6,
      "max": 24,
      "step": 1,
      "default": 11
    },
    {
      "key": "speed",
      "label": "Crawl (px/s)",
      "type": "range",
      "min": -120,
      "max": 120,
      "step": 2,
      "default": 26
    },
    {
      "key": "lamps",
      "label": "Lamp spacing",
      "type": "range",
      "min": 40,
      "max": 140,
      "step": 5,
      "default": 80
    }
  ],
  "layers": [
    {
      "type": "stroke",
      "color": "#000000",
      "alpha": 0.4,
      "width": "=$width+4",
      "blur": 4
    },
    {
      "type": "stroke",
      "color": "#15140a",
      "width": "$width"
    },
    {
      "type": "stroke",
      "color": "$color",
      "width": "$width",
      "cap": "butt",
      "dash": [
        "$stripe",
        "$stripe"
      ],
      "dashSpeed": "$speed"
    },
    {
      "type": "dots",
      "color": "=(i%2)?'#ff2a2a':'#2a7bff'",
      "size": "=$width*0.42",
      "spacing": "$lamps",
      "speed": 0,
      "blur": 6,
      "composite": "lighter",
      "alpha": "=0.1+0.9*((sin(t*7+i*3.14159)>0)?1:0)",
      "offset": "=-$width*1.1"
    }
  ],
  "skin": [
    {
      "type": "disc",
      "color": "#15140a",
      "radius": 1
    },
    {
      "type": "ring",
      "color": "$color",
      "radius": 1,
      "width": 0.26,
      "dash": [
        0.4,
        0.4
      ],
      "speed": 0.1
    },
    {
      "type": "disc",
      "color": "=(sin(t*7)>0)?'#ff2a2a':'#2a7bff'",
      "radius": 0.28,
      "blur": 8
    }
  ],
  "animated": true
}