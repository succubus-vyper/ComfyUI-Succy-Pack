{
  "id": "cobra",
  "name": "Cobra Strike",
  "icon": "⚔",
  "order": 160,
  "description": "A fast cobra that strikes along the wire, then waits.",
  "params": [
    {
      "key": "color",
      "label": "Color",
      "type": "color",
      "default": "#ffb020"
    },
    {
      "key": "size",
      "label": "Thickness",
      "type": "range",
      "min": 1.5,
      "max": 6,
      "step": 0.1,
      "default": 3.2
    },
    {
      "key": "strike",
      "label": "Strike speed",
      "type": "range",
      "min": 100,
      "max": 900,
      "step": 10,
      "default": 260
    },
    {
      "key": "pause",
      "label": "Pause (px)",
      "type": "range",
      "min": 0,
      "max": 800,
      "step": 10,
      "default": 360
    },
    {
      "key": "length",
      "label": "Length",
      "type": "range",
      "min": 20,
      "max": 160,
      "step": 5,
      "default": 70
    },
    {
      "key": "amp",
      "label": "Zigzag",
      "type": "range",
      "min": 0,
      "max": 12,
      "step": 0.5,
      "default": 4
    }
  ],
  "layers": [
    {
      "type": "stroke",
      "color": "$color",
      "alpha": 0.1,
      "width": 1.5
    },
    {
      "type": "dots",
      "shape": "diamond",
      "color": "$color",
      "size": "$size",
      "spacing": "=L+$length+$pause",
      "speed": "$strike",
      "trail": "$length",
      "trailSteps": 24,
      "trailTaper": 0.85,
      "trailFade": 0.25,
      "blur": 8,
      "displace": "=$amp*sin(s/30*6.2832)*sin(v*3.14159)"
    },
    {
      "type": "dots",
      "color": "#ffffff",
      "size": "=$size*0.4",
      "spacing": "=L+$length+$pause",
      "speed": "$strike",
      "displace": "=$amp*sin(s/30*6.2832)*sin(v*3.14159)"
    }
  ],
  "skin": [
    {
      "type": "disc",
      "color": "#16100a",
      "radius": 1
    },
    {
      "type": "pulse",
      "color": "$color",
      "from": 0.6,
      "to": 1.9,
      "period": 0.9,
      "width": 0.12
    },
    {
      "type": "spin",
      "color": "$color",
      "radius": 1,
      "width": 0.2,
      "count": 2,
      "span": 0.3,
      "speed": 1.6
    },
    {
      "type": "disc",
      "color": "$color",
      "radius": 0.26
    }
  ]
}
