{
  "id": "classic",
  "name": "Classic",
  "icon": "●",
  "order": 10,
  "description": "Plain wire, follows the link type color.",
  "params": [
    { "key": "color", "label": "Color", "type": "color", "default": "auto" },
    { "key": "width", "label": "Width", "type": "range", "min": 1, "max": 10, "step": 0.5, "default": 3 }
  ],
  "layers": [
    { "type": "stroke", "color": "#000000", "alpha": 0.3, "width": "=$width+2" },
    { "type": "stroke", "color": "$color", "width": "$width" }
  ],
  "skin": [
    { "type": "disc", "color": "#4b5552", "radius": 1 },
    { "type": "ring", "color": "$color", "radius": 1, "width": 0.12, "alpha": 0.85 },
    { "type": "disc", "color": "#707c78", "radius": 0.66 }
  ]
}
