{
  "version": 1,
  "family": "uiconfig",
  "defaults": {
    "font_size": 24,
    "font_color": "#ffffffff",
    "bg_color": "#00000080",
    "border_color": "#00ffffff",
    "border_color_b": "#ff0000ff",
    "border_width": 3,
    "border_glow": 0,
    "padding": 10,
    "border_radius": 8,
    "bg_color_a": "#000000ff",
    "bg_color_b": "#00ffffff",
    "bg_color_c": "#ff0000ff",
    "bg_speed": 5.0,
	"pattern_color":   "#2dd4bf26",
	"pattern_color_b": "#ff2bd626",
    "pattern_speed": 5.0,
    "text_style_color": "#ff0000ff",
    "text_style_color_b": "#00ffffff",
    "text_style_intensity": 50,
    "text_style_speed": 50,
    "line_height": 1.3,
    "box_shadow": 0,
    "box_shadow_color": "#00000080",
    "bg_grad_color": "#00808080",
    "bg_grad_balance": 50,
    "bg_grad_softness": 40
  },
  "items": {
    "align": {
      "default": "left",
      "options": [
        { "id": "left",   "label": "Left" },
        { "id": "center", "label": "Center" },
        { "id": "right",  "label": "Right" }
      ]
    },
    "align_vertical": {
      "default": "center",
      "options": [
        { "id": "top",    "label": "Top" },
        { "id": "center", "label": "Center" },
        { "id": "bottom", "label": "Bottom" }
      ]
    },
    "gradient": {
      "default": "off",
      "options": [
        { "id": "off",        "label": "Off",        "type": "none" },
        { "id": "linear →",   "label": "Linear →",   "type": "linear", "angle": 90 },
        { "id": "linear ↓",   "label": "Linear ↓",   "type": "linear", "angle": 180 },
        { "id": "diagonal ↘", "label": "Diagonal ↘", "type": "linear", "angle": 135 },
        { "id": "diagonal ↙", "label": "Diagonal ↙", "type": "linear", "angle": 225 },
        { "id": "radial ⊙",   "label": "Radial ⊙",   "type": "radial" }
      ]
    },
    "pattern_blend": {
      "default": "default",
      "options": [
        { "id": "default",    "label": "Default" },
        { "id": "normal",     "label": "Normal" },
        { "id": "screen",     "label": "Screen" },
        { "id": "multiply",   "label": "Multiply" },
        { "id": "overlay",    "label": "Overlay" },
        { "id": "soft-light", "label": "Soft Light" },
        { "id": "difference", "label": "Difference" }
      ]
    }
  }
}